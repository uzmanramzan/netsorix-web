# Public URL of the site (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.netsorix.com

# Contact form delivery via Resend (https://resend.com).
# Leave empty and the form will tell visitors their message was NOT sent.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL="Netsorix <noreply@yourdomain.com>"
